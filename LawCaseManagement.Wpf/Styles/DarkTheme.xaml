<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Palette (§2.1 Color Palette) -->
    <Color x:Key="Color.Primary">#3D6FB4</Color>
    <Color x:Key="Color.PrimaryHover">#5587C9</Color>
    <Color x:Key="Color.Accent">#5C9DF5</Color>
    <Color x:Key="Color.Background">#121826</Color>
    <Color x:Key="Color.Surface">#1C2433</Color>
    <Color x:Key="Color.SurfaceAlt">#242D3F</Color>
    <Color x:Key="Color.Border">#2E394E</Color>
    <Color x:Key="Color.TextPrimary">#E8EBF0</Color>
    <Color x:Key="Color.TextSecondary">#9AA4B5</Color>
    <Color x:Key="Color.Success">#3FBE82</Color>
    <Color x:Key="Color.Warning">#E5A93C</Color>
    <Color x:Key="Color.Error">#F2696C</Color>
    <Color x:Key="Color.Archived">#6B7384</Color>

    <!-- Brush Resources -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource Color.PrimaryHover}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Color.Error}" />
    <SolidColorBrush x:Key="ArchivedBrush" Color="{StaticResource Color.Archived}" />

    <!-- Compatibility Aliases for Existing Views -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Color.Error}" />
    <SolidColorBrush x:Key="ItemCardBackgroundBrush" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#2A3852" />
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#314468" />

    <!-- Status Pill Soft Backgrounds -->
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1E382E" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#3B301A" />
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="#3D2024" />
    <SolidColorBrush x:Key="ArchivedSoftBrush" Color="#252B38" />
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#233552" />

    <Color x:Key="PrimaryColor">#3D6FB4</Color>
    <Color x:Key="AccentColor">#5C9DF5</Color>
</ResourceDictionary>
