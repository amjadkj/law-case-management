<Window x:Class="LawCaseManagement.Wpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:LawCaseManagement.Wpf"
        Title="Justice Flow — Sign In" 
        Height="540" Width="440"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        ResizeMode="NoResize">
    
    <Grid>
        <!-- Full-bleed subtle navy gradient background (§3.1) -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1B3A6B" Offset="0" />
                    <GradientStop Color="#0F2342" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Subtle backdrop decorative glow -->
        <Ellipse Width="340" Height="340" Margin="0,-100,-100,0" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.12">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#2E7BE0" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Main Card (Centered, max-width 400px) -->
        <Border Style="{DynamicResource ModalCardStyle}" 
                Width="380" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Center" 
                Padding="32,28">
            <StackPanel>
                
                <!-- Logo & Brand Header -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                    <TextBlock Text="⚖" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="JUSTICE FLOW" FontSize="20" FontWeight="Bold" 
                               Foreground="{DynamicResource PrimaryBrush}" 
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Case Management System" FontSize="12" 
                               Foreground="{DynamicResource TextSecondaryBrush}" 
                               HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Error Message -->
                <Border Background="{DynamicResource ErrorSoftBrush}" 
                        BorderBrush="{DynamicResource ErrorBrush}" 
                        BorderThickness="1" 
                        CornerRadius="4" 
                        Padding="10,6" 
                        Margin="0,0,0,16"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" 
                               Foreground="{DynamicResource ErrorBrush}" 
                               TextWrapping="Wrap" 
                               FontSize="12" 
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Username Field -->
                <TextBlock Text="Username" FontSize="12" FontWeight="SemiBold" 
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,0,16" Height="36"/>

                <!-- Password Field -->
                <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" 
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="TxtPassword" Margin="0,0,0,18" Height="36"/>

                <!-- Remember Me Checkbox -->
                <CheckBox Content="Remember me" 
                          Foreground="{DynamicResource TextSecondaryBrush}" 
                          FontSize="12" 
                          Margin="0,0,0,20" 
                          IsChecked="True" />

                <!-- Login Button -->
                <Button Content="Sign In" 
                        Command="{Binding LoginCommand}" 
                        CommandParameter="{Binding ElementName=TxtPassword}"
                        Height="40" 
                        FontSize="14" 
                        FontWeight="SemiBold"
                        Margin="0,0,0,20" />

                <!-- Connection status indicator below the form (§3.1) -->
                <Border Background="{DynamicResource SurfaceAltBrush}" 
                        CornerRadius="16" 
                        Padding="12,6" 
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ConnectionStatusDot}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ConnectionStatusText}" FontSize="12" 
                                   Foreground="{DynamicResource TextSecondaryBrush}" 
                                   FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>
    </Grid>
</Window>
