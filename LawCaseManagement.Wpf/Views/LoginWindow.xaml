<Window x:Class="LawCaseManagement.Wpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Justice Flow — Sign In" 
        Height="470" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize">
    
    <Grid Background="{StaticResource BackgroundBrush}">
        <!-- Subtle decorative corner accents -->
        <Border Margin="-60" CornerRadius="300" HorizontalAlignment="Left" VerticalAlignment="Top" Width="360" Height="360" Opacity="0.08">
            <Border.Background>
                <RadialGradientBrush>
                    <GradientStop Color="{StaticResource PrimaryColor}" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        
        <Border Margin="-60" CornerRadius="300" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="360" Height="360" Opacity="0.10">
            <Border.Background>
                <RadialGradientBrush>
                    <GradientStop Color="{StaticResource AccentColor}" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Main Card -->
        <Border Style="{StaticResource CardStyle}" Width="340" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28,24">
            <StackPanel>
                
                <!-- Logo / Title -->
                <TextBlock Text="⚖ JUSTICE FLOW" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" 
                           HorizontalAlignment="Center" Margin="0,4,0,2"/>
                <TextBlock Text="Legal Case Management System" FontSize="11" Foreground="{StaticResource MutedTextBrush}" 
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" 
                           TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12" 
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}" 
                           HorizontalAlignment="Center"/>

                <!-- Username -->
                <TextBlock Text="Username" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                <!-- Password -->
                <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="TxtPassword" Margin="0,0,0,24"/>

                <!-- Login Button -->
                <Button Content="Sign In" 
                        Command="{Binding LoginCommand}" 
                        CommandParameter="{Binding ElementName=TxtPassword}"
                        Height="38" FontSize="13" FontWeight="SemiBold"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>
