<UserControl x:Class="LawCaseManagement.Wpf.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Admin Panel" Style="{StaticResource HeaderTextBlockStyle}"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Tabs for Users + Audit Logs -->
            <TabControl Grid.Column="0" Margin="0,0,8,0" Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        <Setter Property="Background" Value="{StaticResource SidebarBackgroundBrush}"/>
                        <Setter Property="Padding" Value="14,6"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </TabControl.Resources>

                <!-- User Management Tab -->
                <TabItem Header="User Accounts">
                    <DataGrid ItemsSource="{Binding UsersList}" SelectedItem="{Binding SelectedUser}"
                              AutoGenerateColumns="False" Margin="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="120"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/>
                            <DataGridTemplateColumn Header="Status" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Active"/>
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Text" Value="Inactive"/>
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Toggle" Height="24" FontSize="10" Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding DataContext.ToggleUserActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Audit Log Tab -->
                <TabItem Header="Audit Logs">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,8,8,6">
                            <TextBox Text="{Binding AuditLogSearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,8,0" ToolTip="Search audit logs..."/>
                            <Button Content="Search" Command="{Binding SearchLogsCommand}" Width="70"/>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding AuditLogsList}" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat='dd/MM/yy HH:mm'}" Width="120"/>
                                <DataGridTextColumn Header="User" Binding="{Binding User.FullName}" Width="150"/>
                                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="150"/>
                                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
            </TabControl>

            <!-- RIGHT: Create/Edit User Form -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Create User Account" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedUser}" Value="True">
                                        <Setter Property="Text" Value="Edit User Account" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="Full Name *" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FormFullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <TextBlock Text="Username *" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FormUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Password" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock Text=" (leave blank to keep)" FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                   Visibility="{Binding HasSelectedUser, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   VerticalAlignment="Bottom" Margin="4,0,0,0"/>
                    </StackPanel>
                    <TextBox Text="{Binding FormPassword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <TextBlock Text="Role *" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                    <ComboBox SelectedValue="{Binding FormRole}" Margin="0,0,0,10">
                        <ComboBoxItem Content="Admin"/>
                        <ComboBoxItem Content="Lawyer"/>
                        <ComboBoxItem Content="Paralegal"/>
                    </ComboBox>

                    <CheckBox Content="Active Account" IsChecked="{Binding FormIsActive}" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16"/>

                    <WrapPanel>
                        <Button Content="➕ Create" Command="{Binding CreateUserCommand}" Margin="0,0,8,0"
                                Visibility="{Binding HasSelectedUser, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        <Button Content="✏ Update" Command="{Binding UpdateUserCommand}" Margin="0,0,8,0"
                                Visibility="{Binding HasSelectedUser, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Content="Clear" Command="{Binding ClearFormCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
