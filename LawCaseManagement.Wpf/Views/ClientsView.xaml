<UserControl x:Class="LawCaseManagement.Wpf.Views.ClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <!-- ==================== MAIN PAGE TEMPLATE (§2.5, §2.6) ==================== -->
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Page Header -->
                <RowDefinition Height="Auto" /> <!-- Top Bar: Search, Filter, Create (§2.5) -->
                <RowDefinition Height="*" />    <!-- Modern Data Table (§2.6) -->
            </Grid.RowDefinitions>

            <!-- Page Title -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Clients" Style="{DynamicResource PageTitleStyle}"/>
                    <TextBlock Text="Client directory, contact details, and associated matter files" 
                               Style="{DynamicResource CaptionTextStyle}"/>
                </StackPanel>
            </Grid>

            <!-- Top Bar (§2.5): Scoped Search + Filter + Create -->
            <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Padding="12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Scoped Search -->
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                 ToolTip="Search clients by name, phone, email, or address..."
                                 Height="36" Padding="32,0,10,0"/>
                        <TextBlock Text="🔍" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" 
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock Text="Search clients by name, phone, email, or address..." 
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                   VerticalAlignment="Center" Margin="34,0,0,0" IsHitTestVisible="False"
                                   Visibility="{Binding SearchQuery, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Center-right: Filter Button (§2.5) -->
                    <Button Grid.Column="1" 
                            Command="{Binding ToggleFilterModalCommand}" 
                            Style="{DynamicResource SecondaryButtonStyle}" 
                            Height="36" Padding="14,0" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Filter" FontSize="13" VerticalAlignment="Center"/>
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" 
                                     Margin="6,0,0,0" VerticalAlignment="Center"
                                     Visibility="{Binding HasActiveFilters, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Button>

                    <!-- Right: Create Button (§2.5) -->
                    <Button Grid.Column="2" 
                            Content="+ New Client" 
                            Command="{Binding OpenCreateModalCommand}" 
                            Height="36" Padding="16,0"
                            FontSize="13" FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <!-- Modern Data Table (§2.6) -->
            <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding ClientsList}" 
                              SelectedItem="{Binding SelectedClient}"
                              BorderThickness="0">
                        <DataGrid.ItemContainerStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Cursor" Value="Hand"/>
                                <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick"/>
                            </Style>
                        </DataGrid.ItemContainerStyle>

                        <DataGrid.Columns>
                            <!-- Full Name -->
                            <DataGridTemplateColumn Header="FULL NAME" Width="200" SortMemberPath="FullName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Phone -->
                            <DataGridTextColumn Header="PHONE NUMBER" Binding="{Binding Phone}" Width="150" />

                            <!-- Email -->
                            <DataGridTextColumn Header="EMAIL ADDRESS" Binding="{Binding Email}" Width="200" />

                            <!-- Address -->
                            <DataGridTextColumn Header="OFFICE / HOME ADDRESS" Binding="{Binding Address}" Width="*" />

                            <!-- # Linked Cases (§3.4) -->
                            <DataGridTemplateColumn Header="LINKED CASES" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="10" 
                                                Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}">
                                                <Run Text="{Binding CaseClients.Count, Mode=OneWay}"/>
                                                <Run Text=" case(s)"/>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Quick Action: View / Edit -->
                            <DataGridTemplateColumn Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="View" 
                                                Click="ViewButton_Click"
                                                Style="{DynamicResource SecondaryButtonStyle}" 
                                                Height="26" Padding="10,0" FontSize="11" 
                                                HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty State (§2.6) -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32"
                                Visibility="{Binding ClientsList.Count, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <TextBlock Text="👥" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,12" Opacity="0.6"/>
                        <TextBlock Text="No clients yet" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Register your first client to start linking cases and tracking records." 
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <Button Content="+ New Client" Command="{Binding OpenCreateModalCommand}" 
                                HorizontalAlignment="Center" Width="130" Height="36"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== FILTER MODAL POPUP (§2.5) ==================== -->
        <Grid Style="{DynamicResource ModalOverlayStyle}" 
              Visibility="{Binding IsFilterModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Style="{DynamicResource ModalCardStyle}" Width="380" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Filter Clients" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Button HorizontalAlignment="Right" Command="{Binding ToggleFilterModalCommand}" 
                                Style="{DynamicResource IconButtonStyle}">
                            <TextBlock Text="✕" FontSize="13"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="Associated Cases" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox SelectedValue="{Binding LinkedCaseFilter}" SelectedValuePath="Tag" Margin="0,0,0,20" Height="34">
                        <ComboBoxItem Content="All Clients" Tag="All" IsSelected="True"/>
                        <ComboBoxItem Content="Has Linked Cases" Tag="WithCases"/>
                        <ComboBoxItem Content="No Linked Cases" Tag="WithoutCases"/>
                    </ComboBox>

                    <Grid>
                        <Button Content="Clear All" Command="{Binding ClearFiltersCommand}" 
                                Style="{DynamicResource SecondaryButtonStyle}" HorizontalAlignment="Left" Width="100"/>
                        <Button Content="Apply Filters" Command="{Binding ApplyFiltersCommand}" 
                                HorizontalAlignment="Right" Width="120"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== CLIENT VIEW / EDIT / CREATE MODAL (§2.7, §3.4) ==================== -->
        <Grid Style="{DynamicResource ModalOverlayStyle}" 
              Visibility="{Binding IsClientModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Style="{DynamicResource ModalCardStyle}" 
                    Width="640" MaxHeight="660" 
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Header -->
                        <RowDefinition Height="*" />    <!-- Scrollable Body -->
                        <RowDefinition Height="Auto" /> <!-- Footer Actions -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding ModalTitle}" 
                                   FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Command="{Binding CloseClientModalCommand}" 
                                Style="{DynamicResource IconButtonStyle}" ToolTip="Close">
                            <TextBlock Text="✕" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Button>
                    </Grid>

                    <!-- Scrollable Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16" Padding="0,0,8,0">
                        <StackPanel>
                            <!-- Full Name -->
                            <TextBlock Text="Full Legal Name *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding FormFullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" Height="34"/>

                            <!-- Phone & Email -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Phone Number *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Email Address" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                                </StackPanel>
                            </Grid>

                            <!-- Address -->
                            <TextBlock Text="Physical / Mailing Address" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}" 
                                     TextWrapping="Wrap" AcceptsReturn="True" Height="64" 
                                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,18"/>

                            <!-- Inline Linked Cases Panel (§3.4: clickable to jump into case modal) -->
                            <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,14"/>
                                <TextBlock Text="Linked Cases" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                
                                <ItemsControl ItemsSource="{Binding LinkedCasesList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{DynamicResource ItemCardStyle}" Padding="12,10" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileNumber}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                                                        <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Style="{DynamicResource StatusChipBaseStyle}" Margin="0,0,10,0"
                                                            Background="{Binding Status, Converter={StaticResource StatusToChipBackgroundConverter}}">
                                                        <TextBlock Text="{Binding Status}" FontSize="11" 
                                                                   Foreground="{Binding Status, Converter={StaticResource StatusToChipForegroundConverter}}"/>
                                                    </Border>
                                                    <Button Grid.Column="2" Content="Open Case ➔" 
                                                            Command="{Binding DataContext.OpenCaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{DynamicResource SecondaryButtonStyle}" Height="28" Padding="10,0" FontSize="11"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="No active cases linked to this client." 
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontStyle="Italic" Margin="0,4,0,0"
                                           Visibility="{Binding LinkedCasesList.Count, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Actions -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{Binding CloseClientModalCommand}" 
                                    Style="{DynamicResource SecondaryButtonStyle}" Width="90" Height="36" Margin="0,0,10,0"/>
                            <Button Content="{Binding SaveButtonText}" Command="{Binding SaveClientCommand}" 
                                    Width="120" Height="36"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
