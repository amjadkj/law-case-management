<UserControl x:Class="LawCaseManagement.Wpf.Views.ClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Client Database" Style="{StaticResource HeaderTextBlockStyle}" />

        <!-- Two-Panel Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Client List + Search -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                 ToolTip="Search by name, phone, email..." Margin="0,0,0,6"/>
                        <Button Content="Search" Command="{Binding SearchCommand}"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding ClientsList}" SelectedItem="{Binding SelectedClient}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,2">
                                    <StackPanel>
                                        <TextBlock Text="{Binding FullName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="{Binding Phone}" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock Text="{Binding Email}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- RIGHT: Create / Edit Form -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                <StackPanel Margin="4">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Register New Client" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedClient}" Value="True">
                                        <Setter Property="Text" Value="Edit Client Profile" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="Full Name *" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FormFullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                    <TextBlock Text="Phone Number *" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                    <TextBlock Text="Email Address" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                    <TextBlock Text="Address" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}" 
                             TextWrapping="Wrap" Height="60" AcceptsReturn="True" Margin="0,0,0,20"/>

                    <WrapPanel Margin="0,0,0,16">
                        <Button Content="💾 Register Client" Command="{Binding CreateClientCommand}" Margin="0,0,8,0"
                                Visibility="{Binding HasSelectedClient, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        <Button Content="✏ Update Client" Command="{Binding UpdateClientCommand}" Margin="0,0,8,0"
                                Visibility="{Binding HasSelectedClient, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Content="Clear" Command="{Binding ClearFormCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                    </WrapPanel>

                    <!-- Linked Cases Section -->
                    <StackPanel Visibility="{Binding HasSelectedClient, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,12"/>
                        <TextBlock Text="Linked Cases" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding LinkedCasesList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ItemCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding FileNumber}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                                <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock FontSize="10" Foreground="{StaticResource MutedTextBrush}">
                                                    <Run Text="{Binding Status}"/> <Run Text=" · Lawyer: "/> <Run Text="{Binding Lawyer.FullName}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="View Case" Width="85" Height="26" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding DataContext.OpenCaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" FontSize="11"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
