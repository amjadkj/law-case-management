<UserControl x:Class="LawCaseManagement.Wpf.Views.CasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header + Search -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Case Files" Style="{StaticResource HeaderTextBlockStyle}" VerticalAlignment="Center" Margin="0"/>
        </Grid>

        <!-- Two-Panel Layout: List (left) + Detail (right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: List + Search -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                <DockPanel>
                    <!-- Search Bar -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                 ToolTip="Search by file number, title, or client..."
                                 Margin="0,0,0,6"/>
                        <WrapPanel>
                            <ComboBox Width="120" Margin="0,0,6,0" SelectedValue="{Binding StatusFilter}">
                                <ComboBoxItem Content="All" IsSelected="True"/>
                                <ComboBoxItem Content="Open"/>
                                <ComboBoxItem Content="In Progress"/>
                                <ComboBoxItem Content="Closed"/>
                                <ComboBoxItem Content="Archived"/>
                            </ComboBox>
                            <ComboBox Width="110" Margin="0,0,6,0" SelectedValue="{Binding TypeFilter}">
                                <ComboBoxItem Content="All" IsSelected="True"/>
                                <ComboBoxItem Content="Civil"/>
                                <ComboBoxItem Content="Criminal"/>
                                <ComboBoxItem Content="Family"/>
                                <ComboBoxItem Content="Corporate"/>
                                <ComboBoxItem Content="Other"/>
                            </ComboBox>
                            <Button Content="Search" Command="{Binding SearchCommand}" Width="66" />
                        </WrapPanel>
                    </StackPanel>
                    <!-- Cases List -->
                    <ListBox ItemsSource="{Binding CasesList}" SelectedItem="{Binding SelectedCase}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,2">
                                    <StackPanel>
                                        <TextBlock Text="{Binding FileNumber}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                        <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="11" Foreground="{StaticResource MutedTextBrush}">
                                            <Run Text="{Binding Status}"/> <Run Text=" · "/> <Run Text="{Binding CaseType}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- RIGHT: Detail / Create Panel -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Create New Case" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedCase}" Value="True">
                                            <Setter Property="Text" Value="Case Details &amp; Edit" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- File Number -->
                        <TextBlock Text="File Number *" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding FormFileNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                            <Button Grid.Column="1" Content="Auto-generate" Command="{Binding AutoGenerateFileNumberCommand}" Width="110" Style="{StaticResource SecondaryButtonStyle}"/>
                        </Grid>

                        <!-- Title -->
                        <TextBlock Text="Case Title *" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FormTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                        <!-- Case Type + Status -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Case Type" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding FormCaseType}">
                                    <ComboBoxItem Content="Civil"/>
                                    <ComboBoxItem Content="Criminal"/>
                                    <ComboBoxItem Content="Family"/>
                                    <ComboBoxItem Content="Corporate"/>
                                    <ComboBoxItem Content="Other"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Status" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding FormStatus}">
                                    <ComboBoxItem Content="Open"/>
                                    <ComboBoxItem Content="In Progress"/>
                                    <ComboBoxItem Content="Closed"/>
                                    <ComboBoxItem Content="Archived"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Lawyer + Paralegal -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Assigned Lawyer *" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding LawyersList}" SelectedItem="{Binding FormSelectedLawyer}"
                                          DisplayMemberPath="FullName"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Assigned Paralegal *" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding ParalegalsList}" SelectedItem="{Binding FormSelectedParalegal}"
                                          DisplayMemberPath="FullName"/>
                            </StackPanel>
                        </Grid>

                        <!-- Notes -->
                        <TextBlock Text="Notes" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}" 
                                  TextWrapping="Wrap" AcceptsReturn="True" Height="60" 
                                  VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

                        <!-- Client Links -->
                        <TextBlock Text="Linked Clients" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding AllClientsList}" SelectedItem="{Binding FormSelectedClientToLink}"
                                       DisplayMemberPath="FullName" Margin="0,0,6,0"/>
                            <Button Grid.Column="1" Content="+ Link" Command="{Binding AddClientToLinkFormCommand}" Width="65" Style="{StaticResource SecondaryButtonStyle}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding LinkedClientsForForm}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ItemCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding FullName}" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="✕" Width="24" Height="24" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding DataContext.RemoveClientFromLinkFormCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" FontSize="10"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Action Buttons -->
                        <WrapPanel Margin="0,0,0,16">
                            <Button Content="💾 Create Case" Command="{Binding CreateCaseCommand}" Margin="0,0,8,0"
                                    Visibility="{Binding HasSelectedCase, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                            <Button Content="✏ Update Case" Command="{Binding UpdateCaseCommand}" Margin="0,0,8,0"
                                    Visibility="{Binding HasSelectedCase, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </WrapPanel>

                        <!-- Documents Section (only shown when a case is selected) -->
                        <StackPanel Visibility="{Binding HasSelectedCase, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Documents" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Grid.Column="0" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="⬆ Upload" Command="{Binding UploadDocumentCommand}" Width="85" Style="{StaticResource SecondaryButtonStyle}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding SelectedCase.Documents}" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ItemCardStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold"/>
                                                    <TextBlock FontSize="10" Foreground="{StaticResource MutedTextBrush}">
                                                        <Run Text="By "/>
                                                        <Run Text="{Binding UploadedBy.FullName}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding UploadDate, StringFormat='dd MMM yyyy'}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="👁 Open" Width="60" Height="28" Margin="0,0,4,0" Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding DataContext.OpenDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            FontSize="11" ToolTip="Open document in native application"/>
                                                    <Button Content="🗑" Width="28" Height="28" Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding DataContext.DeleteDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding DataContext.IsAdminOrLawyer, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            FontSize="12" ToolTip="Delete document"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Tasks Section -->
                            <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,12"/>
                            <TextBlock Text="Tasks" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                            <!-- Add Task -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding FormNewTaskTitle, UpdateSourceTrigger=PropertyChanged}" 
                                         ToolTip="Task title..." Margin="0,0,4,0"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AllStaffList}" SelectedItem="{Binding FormNewTaskAssignedTo}"
                                          DisplayMemberPath="FullName" Margin="0,0,4,0" ToolTip="Assign to"/>
                                <DatePicker Grid.Column="2" SelectedDate="{Binding FormNewTaskDueDate}" Margin="0,0,4,0"/>
                                <Button Grid.Column="3" Content="Add Task" Command="{Binding CreateTaskCommand}" Width="80"/>
                            </Grid>
                            <!-- Task List -->
                            <ItemsControl ItemsSource="{Binding SelectedCase.Tasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ItemCardStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                                                    <TextBlock FontSize="10" Foreground="{StaticResource MutedTextBrush}">
                                                        <Run Text="Due: "/>
                                                        <Run Text="{Binding DueDate, StringFormat='dd MMM yyyy'}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding AssignedTo.FullName}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="{Binding Status}" Width="90" Height="26" Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding DataContext.ToggleTaskStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        FontSize="10" ToolTip="Click to advance status"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
