<UserControl x:Class="LawCaseManagement.Wpf.Views.CasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <!-- ==================== MAIN PAGE TEMPLATE (§2.5, §2.6) ==================== -->
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Page Title & Stats -->
                <RowDefinition Height="Auto" /> <!-- Top Bar: Search, Filter, Create (§2.5) -->
                <RowDefinition Height="*" />    <!-- Modern Data Table (§2.6) -->
            </Grid.RowDefinitions>

            <!-- Page Title -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Cases" Style="{DynamicResource PageTitleStyle}"/>
                    <TextBlock Text="Manage active legal proceedings, assigned counsel, and case documents" 
                               Style="{DynamicResource CaptionTextStyle}"/>
                </StackPanel>
            </Grid>

            <!-- Top Bar (§2.5): Scoped Search + Filter + Create -->
            <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Padding="12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Scoped Search -->
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                 ToolTip="Search cases by title, file number, or client name..."
                                 Height="36" Padding="32,0,10,0"/>
                        <TextBlock Text="🔍" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" 
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock Text="Search cases by title, file number, or client..." 
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                   VerticalAlignment="Center" Margin="34,0,0,0" IsHitTestVisible="False"
                                   Visibility="{Binding SearchQuery, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Center-right: Filter Button with Active Dot Indicator (§2.5) -->
                    <Button Grid.Column="1" 
                            Command="{Binding ToggleFilterModalCommand}" 
                            Style="{DynamicResource SecondaryButtonStyle}" 
                            Height="36" Padding="14,0" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Filter" FontSize="13" VerticalAlignment="Center"/>
                            <!-- Active Filter Dot Indicator -->
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" 
                                     Margin="6,0,0,0" VerticalAlignment="Center"
                                     Visibility="{Binding HasActiveFilters, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Button>

                    <!-- Right: Create Button (§2.5) -->
                    <Button Grid.Column="2" 
                            Content="+ New Case" 
                            Command="{Binding OpenCreateModalCommand}" 
                            Height="36" Padding="16,0"
                            FontSize="13" FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <!-- Modern Data Table (§2.6) -->
            <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding CasesList}" 
                              SelectedItem="{Binding SelectedCase}"
                              BorderThickness="0">
                        <!-- Double click / Single click row opening modal (§2.6) -->
                        <DataGrid.ItemContainerStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Cursor" Value="Hand"/>
                                <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick"/>
                            </Style>
                        </DataGrid.ItemContainerStyle>

                        <DataGrid.Columns>
                            <!-- File Number -->
                            <DataGridTemplateColumn Header="FILE NUMBER" Width="130" SortMemberPath="FileNumber">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FileNumber}" FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Title -->
                            <DataGridTemplateColumn Header="CASE TITLE" Width="*" SortMemberPath="Title">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}" FontWeight="Medium" 
                                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Case Type -->
                            <DataGridTextColumn Header="TYPE" Binding="{Binding CaseType}" Width="100" />

                            <!-- Status Pill Chip (§2.3, §2.6) -->
                            <DataGridTemplateColumn Header="STATUS" Width="120" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{DynamicResource StatusChipBaseStyle}"
                                                Background="{Binding Status, Converter={StaticResource StatusToChipBackgroundConverter}}">
                                            <TextBlock Text="{Binding Status}" 
                                                       Foreground="{Binding Status, Converter={StaticResource StatusToChipForegroundConverter}}" 
                                                       FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Assigned Lawyer -->
                            <DataGridTemplateColumn Header="ASSIGNED LAWYER" Width="150" SortMemberPath="Lawyer.FullName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Lawyer.FullName}" VerticalAlignment="Center" 
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Assigned Paralegal -->
                            <DataGridTemplateColumn Header="PARALEGAL" Width="140" SortMemberPath="Paralegal.FullName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Paralegal.FullName}" VerticalAlignment="Center" 
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Opened Date -->
                            <DataGridTemplateColumn Header="OPENED DATE" Width="110" SortMemberPath="OpenDate">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding OpenDate, StringFormat='dd MMM yyyy'}" 
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Quick Action: View / Edit -->
                            <DataGridTemplateColumn Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="View" 
                                                Click="ViewButton_Click"
                                                Style="{DynamicResource SecondaryButtonStyle}" 
                                                Height="26" Padding="10,0" FontSize="11" 
                                                HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty State (§2.6) -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32"
                                Visibility="{Binding CasesList.Count, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <TextBlock Text="📂" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,12" Opacity="0.6"/>
                        <TextBlock Text="No cases found" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Try adjusting your search query or active filters, or create a new case." 
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <Button Content="+ Create Case" Command="{Binding OpenCreateModalCommand}" 
                                HorizontalAlignment="Center" Width="130" Height="36"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== FILTER MODAL POPUP (§2.5) ==================== -->
        <Grid Style="{DynamicResource ModalOverlayStyle}" 
              Visibility="{Binding IsFilterModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Style="{DynamicResource ModalCardStyle}" Width="420" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Filter Cases" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Button HorizontalAlignment="Right" Command="{Binding ToggleFilterModalCommand}" 
                                Style="{DynamicResource IconButtonStyle}">
                            <TextBlock Text="✕" FontSize="13"/>
                        </Button>
                    </Grid>

                    <!-- Status Filter -->
                    <TextBlock Text="Case Status" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox SelectedValue="{Binding StatusFilter}" SelectedValuePath="Content" Margin="0,0,0,12" Height="34">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Open"/>
                        <ComboBoxItem Content="In Progress"/>
                        <ComboBoxItem Content="Closed"/>
                        <ComboBoxItem Content="Archived"/>
                    </ComboBox>

                    <!-- Type Filter -->
                    <TextBlock Text="Case Type" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox SelectedValue="{Binding TypeFilter}" SelectedValuePath="Content" Margin="0,0,0,12" Height="34">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Civil"/>
                        <ComboBoxItem Content="Criminal"/>
                        <ComboBoxItem Content="Family"/>
                        <ComboBoxItem Content="Corporate"/>
                        <ComboBoxItem Content="Other"/>
                    </ComboBox>

                    <!-- Lawyer Filter -->
                    <TextBlock Text="Assigned Lawyer" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox ItemsSource="{Binding LawyersList}" SelectedItem="{Binding SelectedLawyerFilter}" 
                              DisplayMemberPath="FullName" Margin="0,0,0,12" Height="34"/>

                    <!-- Paralegal Filter -->
                    <TextBlock Text="Assigned Paralegal" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox ItemsSource="{Binding ParalegalsList}" SelectedItem="{Binding SelectedParalegalFilter}" 
                              DisplayMemberPath="FullName" Margin="0,0,0,20" Height="34"/>

                    <!-- Actions -->
                    <Grid>
                        <Button Content="Clear All" Command="{Binding ClearFiltersCommand}" 
                                Style="{DynamicResource SecondaryButtonStyle}" HorizontalAlignment="Left" Width="100"/>
                        <Button Content="Apply Filters" Command="{Binding ApplyFiltersCommand}" 
                                HorizontalAlignment="Right" Width="120"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== CASE VIEW / EDIT / CREATE MODAL (§2.7, §3.3, §3.6) ==================== -->
        <Grid Style="{DynamicResource ModalOverlayStyle}" 
              Visibility="{Binding IsCaseModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Style="{DynamicResource ModalCardStyle}" 
                    Width="640" MaxHeight="680" 
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Header -->
                        <RowDefinition Height="*" />    <!-- Scrollable Body -->
                        <RowDefinition Height="Auto" /> <!-- Footer Actions -->
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding ModalTitle}" 
                                   FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Command="{Binding CloseCaseModalCommand}" 
                                Style="{DynamicResource IconButtonStyle}" ToolTip="Close (Esc)">
                            <TextBlock Text="✕" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Button>
                    </Grid>

                    <!-- Scrollable Modal Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16" Padding="0,0,8,0">
                        <StackPanel>
                            <!-- Conflict Warning Banner (§3.3: visible to Admin when conflict detected) -->
                            <Border Background="{DynamicResource ErrorSoftBrush}" 
                                    BorderBrush="{DynamicResource ErrorBrush}" 
                                    BorderThickness="1" CornerRadius="6" 
                                    Padding="12,10" Margin="0,0,0,16"
                                    Visibility="{Binding ShowConflictBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚠ " FontSize="14" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Conflict — needs review. This case was modified concurrently on another device." 
                                               Foreground="{DynamicResource ErrorBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- File Number & Title -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- File Number -->
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="File Number *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <Grid>
                                        <TextBox Text="{Binding FormFileNumber, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Title -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Case Title *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding FormTitle, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                                </StackPanel>
                            </Grid>

                            <!-- Case Type & Status -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Case Type" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox SelectedValue="{Binding FormCaseType}" SelectedValuePath="Content" Height="34">
                                        <ComboBoxItem Content="Civil"/>
                                        <ComboBoxItem Content="Criminal"/>
                                        <ComboBoxItem Content="Family"/>
                                        <ComboBoxItem Content="Corporate"/>
                                        <ComboBoxItem Content="Other"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Status" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox SelectedValue="{Binding FormStatus}" SelectedValuePath="Content" Height="34">
                                        <ComboBoxItem Content="Open"/>
                                        <ComboBoxItem Content="In Progress"/>
                                        <ComboBoxItem Content="Closed"/>
                                        <ComboBoxItem Content="Archived"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Assigned Counsel -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Assigned Lawyer *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding LawyersList}" SelectedItem="{Binding FormSelectedLawyer}" 
                                              DisplayMemberPath="FullName" Height="34"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Assigned Paralegal *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding ParalegalsList}" SelectedItem="{Binding FormSelectedParalegal}" 
                                              DisplayMemberPath="FullName" Height="34"/>
                                </StackPanel>
                            </Grid>

                            <!-- Notes -->
                            <TextBlock Text="Case Notes" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}" 
                                     TextWrapping="Wrap" AcceptsReturn="True" Height="70" 
                                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"/>

                            <!-- Linked Clients (§3.3) -->
                            <TextBlock Text="Linked Clients" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding AllClientsList}" SelectedItem="{Binding FormSelectedClientToLink}"
                                          DisplayMemberPath="FullName" Margin="0,0,8,0" Height="34"/>
                                <Button Grid.Column="1" Content="+ Link Client" Command="{Binding AddClientToLinkFormCommand}" 
                                        Style="{DynamicResource SecondaryButtonStyle}" Height="34" Padding="12,0"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding LinkedClientsForForm}" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{DynamicResource ItemCardStyle}" Padding="10,6" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding FullName}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="✕" Width="22" Height="22" Style="{DynamicResource IconButtonStyle}"
                                                        Command="{Binding DataContext.RemoveClientFromLinkFormCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" ToolTip="Unlink client"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Inline Documents List (§3.6: nested inside modal) -->
                            <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Separator Background="{DynamicResource BorderBrush}" Margin="0,8,0,14"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Documents" FontSize="14" FontWeight="SemiBold" 
                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="⬆ Upload Document" Command="{Binding UploadDocumentCommand}" 
                                            Style="{DynamicResource SecondaryButtonStyle}" Height="30" Padding="10,0"/>
                                </Grid>
                                
                                <ItemsControl ItemsSource="{Binding CaseDocuments}" Margin="0,0,0,16">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{DynamicResource ItemCardStyle}" Padding="12,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="📄" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                                            <Run Text="By "/><Run Text="{Binding UploadedBy.FullName}"/><Run Text=" · "/><Run Text="{Binding UploadDate, StringFormat='dd MMM yyyy'}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="Open" Command="{Binding DataContext.OpenDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" Style="{DynamicResource SecondaryButtonStyle}" Height="26" Padding="8,0" Margin="0,0,6,0"/>
                                                        <Button Content="Delete" Command="{Binding DataContext.DeleteDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" Style="{DynamicResource DangerButtonStyle}" Height="26" Padding="8,0"
                                                                Visibility="{Binding DataContext.IsAdminOrLawyer, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Inline Tasks List (§3.6) -->
                                <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,14"/>
                                <TextBlock Text="Linked Tasks" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding CaseTasks}" Margin="0,0,0,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{DynamicResource ItemCardStyle}" Padding="10,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                                            <Run Text="Assigned to "/><Run Text="{Binding AssignedTo.FullName}"/><Run Text=" · Due "/><Run Text="{Binding DueDate, StringFormat='dd MMM yyyy'}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Style="{DynamicResource StatusChipBaseStyle}" Margin="0,0,8,0"
                                                            Background="{Binding Status, Converter={StaticResource StatusToChipBackgroundConverter}}">
                                                        <TextBlock Text="{Binding Status}" FontSize="11" 
                                                                   Foreground="{Binding Status, Converter={StaticResource StatusToChipForegroundConverter}}"/>
                                                    </Border>
                                                    <Button Grid.Column="2" Content="Cycle" Command="{Binding DataContext.ToggleTaskStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Style="{DynamicResource SecondaryButtonStyle}" Height="24" Padding="6,0" FontSize="10"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Modal Footer Actions (§2.7) -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{Binding CloseCaseModalCommand}" 
                                    Style="{DynamicResource SecondaryButtonStyle}" Width="90" Height="36" Margin="0,0,10,0"/>
                            <Button Content="{Binding SaveButtonText}" Command="{Binding SaveCaseCommand}" 
                                    Width="120" Height="36"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
