<UserControl x:Class="LawCaseManagement.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- Header -->
            <TextBlock Text="Dashboard" Style="{StaticResource HeaderTextBlockStyle}" />

            <!-- Stats Row -->
            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,16">
                <!-- Total Cases -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Total Cases" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                        <TextBlock Text="{Binding TotalCasesCount}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                    </StackPanel>
                </Border>
                <!-- Open Cases -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Open" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                        <TextBlock Text="{Binding OpenCasesCount}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                    </StackPanel>
                </Border>
                <!-- In Progress Cases -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="In Progress" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                        <TextBlock Text="{Binding InProgressCasesCount}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
                    </StackPanel>
                </Border>
                <!-- Closed Cases -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Closed/Archived" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                        <TextBlock Text="{Binding ClosedCasesCount}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Two-column layout: My Cases + My Tasks -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- My Cases -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="My Cases" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding MyCases}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ItemCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                             <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding FileNumber}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                                                <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border CornerRadius="3" Padding="6,2" Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                                                </Border>
                                                <Button Content="View" Height="24" Width="48" FontSize="11"
                                                        Command="{Binding DataContext.OpenCaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No cases assigned." Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                                   Visibility="{Binding MyCases.Count, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <!-- My Tasks -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="My Pending Tasks" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Grid.Column="0"/>
                            <Button Content="View All" Command="{Binding OpenTasksCommand}" Height="24" Width="68" FontSize="11" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding MyTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ItemCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="11" Foreground="{StaticResource MutedTextBrush}">
                                                    <Run Text="Due: "/>
                                                    <Run Text="{Binding DueDate, StringFormat='dd MMM yyyy'}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="1" CornerRadius="3" Padding="6,2" Background="{StaticResource SelectedBackgroundBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No pending tasks." Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                                   Visibility="{Binding MyTasks.Count, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent Activity -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Recent System Activity" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                    <DataGrid ItemsSource="{Binding RecentActivity}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat='dd MMM HH:mm'}" Width="120"/>
                            <DataGridTextColumn Header="User" Binding="{Binding User.FullName}" Width="160"/>
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="150"/>
                            <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
