<UserControl x:Class="LawCaseManagement.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Dashboard" Style="{DynamicResource PageTitleStyle}" />
                <TextBlock Text="Overview of matter caseload, upcoming milestones, and office activity" 
                           Style="{DynamicResource CaptionTextStyle}"/>
            </StackPanel>

            <!-- Stats Row (§3.2: 4 metric cards with colored left-accent bar) -->
            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,20">
                <!-- Total Cases -->
                <Border Style="{DynamicResource CardStyle}" Margin="0,0,12,0" Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="{DynamicResource PrimaryBrush}" RadiusX="2" RadiusY="2"/>
                        <StackPanel Grid.Column="1" Margin="16,14">
                            <TextBlock Text="TOTAL CASES" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalCasesCount}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Open Cases -->
                <Border Style="{DynamicResource CardStyle}" Margin="0,0,12,0" Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="{DynamicResource SuccessBrush}" RadiusX="2" RadiusY="2"/>
                        <StackPanel Grid.Column="1" Margin="16,14">
                            <TextBlock Text="OPEN" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding OpenCasesCount}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- In Progress Cases -->
                <Border Style="{DynamicResource CardStyle}" Margin="0,0,12,0" Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="{DynamicResource WarningBrush}" RadiusX="2" RadiusY="2"/>
                        <StackPanel Grid.Column="1" Margin="16,14">
                            <TextBlock Text="IN PROGRESS" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding InProgressCasesCount}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Closed / Archived Cases -->
                <Border Style="{DynamicResource CardStyle}" Margin="0" Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="{DynamicResource ArchivedBrush}" RadiusX="2" RadiusY="2"/>
                        <StackPanel Grid.Column="1" Margin="16,14">
                            <TextBlock Text="CLOSED / ARCHIVED" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ClosedCasesCount}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- Two-column layout: My Cases + My Tasks (§3.2) -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- My Cases -->
                <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="My Cases" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                        <ItemsControl ItemsSource="{Binding MyCases}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{DynamicResource ItemCardStyle}" Margin="0,0,0,8" Padding="14,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding FileNumber}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Style="{DynamicResource StatusChipBaseStyle}" Margin="0,0,8,0"
                                                        Background="{Binding Status, Converter={StaticResource StatusToChipBackgroundConverter}}">
                                                    <TextBlock Text="{Binding Status}" FontSize="11" 
                                                               Foreground="{Binding Status, Converter={StaticResource StatusToChipForegroundConverter}}"/>
                                                </Border>
                                                <Button Content="View" Height="28" Width="54" FontSize="11"
                                                        Style="{DynamicResource SecondaryButtonStyle}"
                                                        Command="{Binding DataContext.OpenCaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No active cases assigned to you." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontStyle="Italic"
                                   Visibility="{Binding MyCases.Count, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <!-- My Tasks -->
                <Border Grid.Column="1" Style="{DynamicResource CardStyle}" Margin="10,0,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="My Tasks" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Grid.Column="0"/>
                            <Button Content="View All ➔" Command="{Binding OpenTasksCommand}" Height="28" Width="85" FontSize="11" Grid.Column="1" Style="{DynamicResource SecondaryButtonStyle}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding MyTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{DynamicResource ItemCardStyle}" Margin="0,0,0,8" Padding="14,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0">
                                                    <Run Text="Due: "/>
                                                    <Run Text="{Binding DueDate, StringFormat='dd MMM yyyy'}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{DynamicResource StatusChipBaseStyle}" VerticalAlignment="Center"
                                                    Background="{Binding Status, Converter={StaticResource StatusToChipBackgroundConverter}}">
                                                <TextBlock Text="{Binding Status}" FontSize="11" 
                                                           Foreground="{Binding Status, Converter={StaticResource StatusToChipForegroundConverter}}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No pending tasks assigned." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontStyle="Italic"
                                   Visibility="{Binding MyTasks.Count, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent Team Activity (§3.2) -->
            <Border Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Recent Team Activity" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <DataGrid ItemsSource="{Binding RecentActivity}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="240">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TIMESTAMP" Binding="{Binding Timestamp, StringFormat='dd MMM HH:mm'}" Width="130"/>
                            <DataGridTextColumn Header="USER" Binding="{Binding User.FullName}" Width="160"/>
                            <DataGridTextColumn Header="ACTION" Binding="{Binding Action}" Width="150"/>
                            <DataGridTextColumn Header="DETAILS" Binding="{Binding Details}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
