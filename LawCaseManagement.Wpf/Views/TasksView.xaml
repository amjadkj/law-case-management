<UserControl x:Class="LawCaseManagement.Wpf.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <!-- ==================== MAIN PAGE TEMPLATE (§2.5, §2.6) ==================== -->
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Page Header -->
                <RowDefinition Height="Auto" /> <!-- Top Bar: Search, Filter, Create (§2.5) -->
                <RowDefinition Height="*" />    <!-- Modern Data Table (§2.6) -->
            </Grid.RowDefinitions>

            <!-- Page Title -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Tasks" Style="{DynamicResource PageTitleStyle}"/>
                    <TextBlock Text="Track legal assignments, filings, hearings, and staff workflow" 
                               Style="{DynamicResource CaptionTextStyle}"/>
                </StackPanel>
            </Grid>

            <!-- Top Bar (§2.5): Scoped Search + Filter + Create -->
            <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Padding="12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Scoped Search -->
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                 ToolTip="Search tasks by title, case, or assigned staff..."
                                 Height="36" Padding="32,0,10,0"/>
                        <TextBlock Text="🔍" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" 
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock Text="Search tasks by title, case, or assigned staff..." 
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                   VerticalAlignment="Center" Margin="34,0,0,0" IsHitTestVisible="False"
                                   Visibility="{Binding SearchQuery, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Center-right: Filter Button (§2.5) -->
                    <Button Grid.Column="1" 
                            Command="{Binding ToggleFilterModalCommand}" 
                            Style="{DynamicResource SecondaryButtonStyle}" 
                            Height="36" Padding="14,0" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Filter" FontSize="13" VerticalAlignment="Center"/>
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" 
                                     Margin="6,0,0,0" VerticalAlignment="Center"
                                     Visibility="{Binding HasActiveFilters, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Button>

                    <!-- Right: Create Button (§2.5) -->
                    <Button Grid.Column="2" 
                            Content="+ New Task" 
                            Command="{Binding OpenCreateModalCommand}" 
                            Height="36" Padding="16,0"
                            FontSize="13" FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <!-- Modern Data Table (§2.6) -->
            <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding TasksList}" 
                              SelectedItem="{Binding SelectedTask}"
                              BorderThickness="0">
                        <DataGrid.ItemContainerStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Cursor" Value="Hand"/>
                                <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick"/>
                            </Style>
                        </DataGrid.ItemContainerStyle>

                        <DataGrid.Columns>
                            <!-- Task Title -->
                            <DataGridTemplateColumn Header="TASK DESCRIPTION" Width="*" SortMemberPath="Title">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}" FontWeight="Medium" 
                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Linked Case -->
                            <DataGridTemplateColumn Header="LINKED CASE" Width="180" SortMemberPath="Case.FileNumber">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Case.FileNumber}" FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
                                            <TextBlock Text="{Binding Case.Title}" FontSize="11" 
                                                       Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Assigned Staff -->
                            <DataGridTemplateColumn Header="ASSIGNED STAFF" Width="160" SortMemberPath="AssignedTo.FullName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AssignedTo.FullName}" VerticalAlignment="Center" 
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status Pill Chip (§2.3, §2.6) -->
                            <DataGridTemplateColumn Header="STATUS" Width="130" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{DynamicResource StatusChipBaseStyle}"
                                                Background="{Binding Status, Converter={StaticResource StatusToChipBackgroundConverter}}">
                                            <TextBlock Text="{Binding Status}" 
                                                       Foreground="{Binding Status, Converter={StaticResource StatusToChipForegroundConverter}}" 
                                                       FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Due Date -->
                            <DataGridTemplateColumn Header="DUE DATE" Width="120" SortMemberPath="DueDate">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DueDate, StringFormat='dd MMM yyyy'}" 
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cycle Status Quick Button -->
                            <DataGridTemplateColumn Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Cycle" 
                                                Command="{Binding DataContext.CycleStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{DynamicResource SecondaryButtonStyle}" 
                                                Height="26" Padding="8,0" FontSize="11" 
                                                HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty State (§2.6) -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32"
                                Visibility="{Binding TasksList.Count, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <TextBlock Text="📋" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,12" Opacity="0.6"/>
                        <TextBlock Text="No tasks found" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="All caught up! Create a new task to delegate action items." 
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <Button Content="+ Create Task" Command="{Binding OpenCreateModalCommand}" 
                                HorizontalAlignment="Center" Width="130" Height="36"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== FILTER MODAL POPUP (§2.5) ==================== -->
        <Grid Style="{DynamicResource ModalOverlayStyle}" 
              Visibility="{Binding IsFilterModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Style="{DynamicResource ModalCardStyle}" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Filter Tasks" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Button HorizontalAlignment="Right" Command="{Binding ToggleFilterModalCommand}" 
                                Style="{DynamicResource IconButtonStyle}">
                            <TextBlock Text="✕" FontSize="13"/>
                        </Button>
                    </Grid>

                    <!-- Status -->
                    <TextBlock Text="Task Status" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox SelectedValue="{Binding StatusFilter}" SelectedValuePath="Content" Margin="0,0,0,12" Height="34">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Pending"/>
                        <ComboBoxItem Content="In Progress"/>
                        <ComboBoxItem Content="Completed"/>
                    </ComboBox>

                    <!-- Staff -->
                    <TextBlock Text="Assigned Staff" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox ItemsSource="{Binding StaffList}" SelectedItem="{Binding SelectedStaffFilter}" 
                              DisplayMemberPath="FullName" Margin="0,0,0,12" Height="34"/>

                    <!-- Case -->
                    <TextBlock Text="Linked Case" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox ItemsSource="{Binding CasesList}" SelectedItem="{Binding SelectedCaseFilter}" 
                              DisplayMemberPath="FileNumber" Margin="0,0,0,20" Height="34"/>

                    <Grid>
                        <Button Content="Clear All" Command="{Binding ClearFiltersCommand}" 
                                Style="{DynamicResource SecondaryButtonStyle}" HorizontalAlignment="Left" Width="100"/>
                        <Button Content="Apply Filters" Command="{Binding ApplyFiltersCommand}" 
                                HorizontalAlignment="Right" Width="120"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== TASK VIEW / EDIT / CREATE MODAL (§2.7, §3.5: max-width 480px) ==================== -->
        <Grid Style="{DynamicResource ModalOverlayStyle}" 
              Visibility="{Binding IsTaskModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Style="{DynamicResource ModalCardStyle}" 
                    Width="480" MaxHeight="600" 
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Header -->
                        <RowDefinition Height="*" />    <!-- Scrollable Body -->
                        <RowDefinition Height="Auto" /> <!-- Footer Actions -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding ModalTitle}" 
                                   FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Command="{Binding CloseTaskModalCommand}" 
                                Style="{DynamicResource IconButtonStyle}" ToolTip="Close">
                            <TextBlock Text="✕" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Button>
                    </Grid>

                    <!-- Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16" Padding="0,0,4,0">
                        <StackPanel>
                            <!-- Task Title -->
                            <TextBlock Text="Task Title *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding FormTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" Height="34"/>

                            <!-- Linked Case Dropdown -->
                            <TextBlock Text="Linked Case *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding CasesList}" SelectedItem="{Binding FormSelectedCase}" 
                                      DisplayMemberPath="FileNumber" Margin="0,0,0,14" Height="34"/>

                            <!-- Assigned Staff Dropdown -->
                            <TextBlock Text="Assign To *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding StaffList}" SelectedItem="{Binding FormAssignedTo}" 
                                      DisplayMemberPath="FullName" Margin="0,0,0,14" Height="34"/>

                            <!-- Status & Due Date -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Status" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox SelectedValue="{Binding FormStatus}" SelectedValuePath="Content" Height="34">
                                        <ComboBoxItem Content="Pending"/>
                                        <ComboBoxItem Content="In Progress"/>
                                        <ComboBoxItem Content="Completed"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Due Date" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <DatePicker SelectedDate="{Binding FormDueDate}" Height="34"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Actions -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                        <Grid>
                            <Button Content="Delete" Command="{Binding DeleteTaskCommand}" CommandParameter="{Binding SelectedTask}"
                                    Style="{DynamicResource DangerButtonStyle}" Height="36" Width="80" HorizontalAlignment="Left"
                                    Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Command="{Binding CloseTaskModalCommand}" 
                                        Style="{DynamicResource SecondaryButtonStyle}" Width="90" Height="36" Margin="0,0,10,0"/>
                                <Button Content="{Binding SaveButtonText}" Command="{Binding SaveTaskCommand}" 
                                        Width="120" Height="36"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
