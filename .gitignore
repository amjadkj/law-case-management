## .gitignore for Law Case Management (C# WPF / .NET)

# ── Build outputs ───────────────────────────────────────────────
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# ── .NET / MSBuild ──────────────────────────────────────────────
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.vs/

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/
!packages/repositories.config
NuGet.Config
project.lock.json
project.fragment.lock.json
artifacts/

# Publish output
publish/
PublishProfiles/
**/Properties/PublishProfiles/

# ── Visual Studio ────────────────────────────────────────────────
.vs/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.opendb
_ReSharper*/
*.DotSettings.user

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
TestResults/
*.trx
*.coverage
*.coveragexml

# ── JetBrains Rider ─────────────────────────────────────────────
.idea/
*.sln.iml

# ── Database (local SQLite) ──────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ── OS generated ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Secrets & environment ────────────────────────────────────────
*.env
*.env.local
appsettings.Local.json
secrets.json

# ── Crash dumps ──────────────────────────────────────────────────
*.dmp
*.mdmp
